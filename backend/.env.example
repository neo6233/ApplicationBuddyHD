# Use the local in-memory vector search by default
VECTOR_DB_MODE=local

# To use Qdrant instead, set VECTOR_DB_MODE=qdrant and configure these values:
QDRANT_URL=https://your-qdrant-host
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION_NAME=aria_knowledge
QDRANT_VECTOR_DIM=256
QDRANT_DISTANCE=Cosine
